# Directories
/.cache               export-ignore
/.github              export-ignore
/.wordpress-org       export-ignore
/docs                 export-ignore

# Retain only the directly loaded MCP source assets in Git archives.
/assets/src/*                    export-ignore
/assets/src/js                   -export-ignore
/assets/src/js/*                 export-ignore
/assets/src/js/admin             -export-ignore
/assets/src/js/admin/*           export-ignore
/assets/src/js/admin/mcp         -export-ignore
/assets/src/css                  -export-ignore
/assets/src/css/*                export-ignore
/assets/src/css/admin            -export-ignore
/assets/src/css/admin/*          export-ignore
/assets/src/css/admin/mcp        -export-ignore

# Files
/.editorconfig        export-ignore
/.gitattributes       export-ignore
/.gitignore           export-ignore

/composer.json        export-ignore
/composer.lock        export-ignore
/yarn.lock            export-ignore
/package-lock.json    export-ignore
/package.json         export-ignore
/phpcs.xml.dist       export-ignore
/postcss.config.js    export-ignore
/pot.js               export-ignore
/README.md            export-ignore

/webpack-entry-list.js   export-ignore
/webpack.common.js       export-ignore
/webpack.dev.js          export-ignore
/webpack.dev.vue.js      export-ignore
/webpack.prod.js         export-ignore

# Merge strategy
package.json merge=keep-local
